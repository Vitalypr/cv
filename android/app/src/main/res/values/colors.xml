<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-surface mirror of the design tokens in ui/theme/Color.kt. RemoteViews
     cannot read Compose values, so shared tokens must be changed in both files
     (docs/dev/ui-guidelines.md). Nothing else may define a color here. -->
<resources>
    <color name="petrol">#0B6E6A</color>
    <color name="petrol_deep">#085250</color>
    <color name="ink">#1B2733</color>
    <color name="ink_secondary">#5A6B77</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="on_accent_muted">#CFE3E2</color>

    <!-- Widget-only status pair (product-owner decision, spec §5.6): the pills sit
         on dark fills, so these are the light-enough variants of the send-green /
         alert semantics. Not used anywhere in the Compose UI. -->
    <color name="widget_check">#4CD98A</color>
    <color name="widget_missing">#FF8A80</color>
</resources>

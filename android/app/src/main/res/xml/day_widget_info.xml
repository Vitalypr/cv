<?xml version="1.0" encoding="utf-8"?>
<!--
  4 cells wide x 1 cell tall, horizontally resizable down to 2 cells.
  updatePeriodMillis=0: the widget never polls — it is redrawn only when the
  data actually changes (spec N6 battery invariants).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_day"
    android:previewLayout="@layout/widget_day"
    android:description="@string/widget_description"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="100dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
